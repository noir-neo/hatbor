<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="ConfigRoot.uss" />
    <ui:VisualElement name="config-root" picking-mode="Ignore" class="config-root">
        <ui:Button name="panel-toggle" text="Settings (H)" class="panel-toggle" />
        <ui:VisualElement name="config-panel" class="config-panel">
            <ui:VisualElement name="status-bar" class="status-bar" />
            <ui:ScrollView name="config-groups" class="config-groups" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
